# ==============================================================
# PT Umbrella Corp Healthcare - Production Environment Configuration
# CATATAN KEAMANAN:
# Kunci API di bawah ini disimpan di SERVER-SIDE (server.js).
# JANGAN gunakan prefix VITE_ untuk secret key agar tidak bocor ke browser!
# ==============================================================

# Port Backend Server
PORT=5000

# DeepSeek Official API Key (Direkomendasikan)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter Gateway Key (Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Opsional)
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram Speech-to-Text (STT) API Key
DEEPGRAM_API_KEY=your_deepgram_api_key_here
